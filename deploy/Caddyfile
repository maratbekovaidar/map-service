# SITE_ADDRESS comes from .env:
#   maps.example.com -> automatic HTTPS (Let's Encrypt), ports 80/443 open
#   :80              -> plain HTTP (local / behind another TLS terminator)

# Log lines carry the full request URI and all request headers, and Caddy
# redacts only Cookie/Authorization by default. API keys arrive in the
# X-API-Key header (logged under its canonical name X-Api-Key) and, for
# deploy/tiles/preview.html, in the ?key= query parameter - neither may reach
# the logs. Referer is covered too: it can echo the preview URL.
# The query is redacted with a regexp rather than the `query` filter: that one
# re-parses the query and silently drops every pair containing ";", and
# routing uses points=lon,lat;lon,lat.
# Applied twice (below): access lines go through the site `log`, but error
# lines (e.g. "dial tcp: ... no such host" with the whole request) go through
# the default logger, which only the global `log` configures.
(redact_api_keys) {
	wrap json
	request>headers>X-Api-Key replace REDACTED
	request>uri regexp "([?&;]key=)[^&;#]*" "${1}REDACTED"
	request>headers>Referer regexp "([?&;]key=)[^&;#]*" "${1}REDACTED"
}

{
	# The admin API is not needed and must not be reachable.
	admin off

	log {
		format filter {
			import redact_api_keys
		}
	}
}

{$SITE_ADDRESS::80} {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Trip tracking goes to the trips service, everything else to the
	# gateway. Caching headers (Cache-Control, ETag) for tiles are set by the
	# gateway itself, Caddy passes them through. Caddy appends the client
	# address to X-Forwarded-For; both services trust it only from
	# TRUSTED_PROXY_CIDRS. Trip tokens travel in Authorization, which Caddy
	# never logs.
	# No compression for trips: its answers are small, and an encoder would
	# hold back the event stream (/v1/trips/{id}/events).
	@trips path /v1/trips /v1/trips/*
	handle @trips {
		reverse_proxy trips:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 40s
			}
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy gateway:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 40s
			}
		}
	}

	log {
		output stdout
		format filter {
			import redact_api_keys
		}
	}
}
