    "building": {
      "note": "2GIS flat buildings (z14-16): light fill, darker outline",
      "maxzoom": 16,
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["zoom"], 13, "#F3F0E3", 14.3, "#FAF8E8", 14.7, "#FFFDED", 16, "#FCFBED"],
