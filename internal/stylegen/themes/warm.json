    "building-3d": {
      "note": "2GIS Building 3D from z16: light roofs, soft walls (low light intensity above, no dark base gradient)",
      "minzoom": 16,
      "paint": {"fill-extrusion-color": "#F4F0E1", "fill-extrusion-opacity": 0.9, "fill-extrusion-vertical-gradient": false}
    },
    "boundary_3": {"paint": {"line-color": "#B9B6A5"}},
    "boundary_2_z0-4": {"paint": {"line-color": "#AAAAAA"}},
    "boundary_2_z5-": {"paint": {"line-color": "#AAAAAA"}},

    "water_name_line": {
      "note": "2GIS River labels",
      "layout": {"text-font": ["Noto Sans Italic"]},
      "paint": {"text-color": "#226E99", "text-halo-color": "rgba(255,255,255,0.5)"}
    },
    "water_name_point": {
      "layout": {"text-font": ["Noto Sans Italic"]},
      "paint": {"text-color": "#226E99", "text-halo-color": "rgba(255,255,255,0.5)"}
    },
