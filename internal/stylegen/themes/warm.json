{
  "id": "warm",
  "base": "liberty",
  "name": "Warm",
  "description": "Warm cream land, orange arterials, grey-outlined white streets, light buildings and translucent brown district labels.",
  "derived-from": "Own colour scheme of this repository",
  "notes": [
    "Source note (not served to clients): the palette is modelled on the default 2GIS MapGL theme (styles.2gis.com export). Only colour values and a few line widths/text sizes were reused; no 2GIS icons, fonts, models, textures or code. 2GIS road/area classes were mapped to OpenMapTiles ones:",
    "2GIS Federal -> motorway, Magistral -> trunk/primary/secondary (+ links), Main -> tertiary, Other -> minor, Internal -> service/track. Secondary counts as Magistral because Astana's big prospects are tagged secondary in OSM.",
    "Liberty's POI icons (Maki) stay; POI label colours follow 2GIS's five category colours (red health, orange food, yellow leisure/lodging, green shops/nature, blue services).",
    "Edit a value, run `make style-assets` and reload the preview (?style=warm). A null paint/layout value removes the property."
  ],
  "light": {"anchor": "viewport", "color": "#FFFFFF", "intensity": 0.25, "position": [1.15, 230, 40]},
  "layers": {
    "background": {
      "note": "2GIS Country/Region area",
      "paint": {"background-color": ["interpolate", ["linear"], ["zoom"], 0, "#FFFCF0", 9, "#F5F0D6", 12, "#F1EEE0", 14, "#F4F1E1", 16, "#F7F6E8"]}
    },
    "park": {
      "note": "2GIS Vegetation feature (Forest_quarter)",
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["zoom"], 10, "#CCE39D", 12, "#C7E295", 15, "#C0DD8A", 17, "#BCDD86"],
        "fill-opacity": null,
        "fill-outline-color": "hsl(83, 56%, 68%)"
      }
    },
    "park_outline": {
      "paint": {
        "line-color": "hsl(83, 56%, 68%)",
        "line-dasharray": null,
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 13.9, 0, 14, 1]
      }
    },
    "landuse_residential": {
      "note": "2GIS Residential (Dwelling_quarter); Liberty shows it only below z8, 2GIS at every zoom",
      "maxzoom": 24,
      "paint": {"fill-color": ["interpolate", ["linear"], ["zoom"], 1, "#F2EDD4", 12, "#EBE9D5", 15, "#EEECDD", 17, "#EDECDF"]}
    },
    "landcover_wood": {
      "note": "2GIS Forest",
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["zoom"], 3.2, "#E0EEB6", 10, "#CCE39D", 12, "#C7E295", 15, "#C0DD8A", 17, "#BCDD86"],
        "fill-opacity": null
      }
    },
    "landcover_grass": {
      "note": "2GIS Flowerbed / lawns",
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["zoom"], 12, "#C7E295", 15, "#CDE5A5", 17, "#D3EDAF"],
        "fill-opacity": 0.8
      }
    },
    "landcover_sand": {"paint": {"fill-color": "#F8F4E3"}},
    "landuse_cemetery": {"note": "2GIS Cemetery", "paint": {"fill-color": "#D8E0BD"}},
    "landuse_pitch": {"paint": {"fill-color": "#D3EDAF"}},
    "landuse_track": {"paint": {"fill-color": "#E6E3D7"}},
    "landuse_hospital": {
      "note": "2GIS Area_of_interest tint",
      "paint": {"fill-color": ["interpolate", ["linear"], ["zoom"], 11, "rgba(241,227,153,0.25)", 14, "rgba(245,230,159,0.35)", 16, "rgba(236,230,163,0.25)"]}
    },
    "landuse_school": {
      "note": "2GIS Area_of_interest tint",
      "paint": {"fill-color": ["interpolate", ["linear"], ["zoom"], 11, "rgba(241,227,153,0.25)", 14, "rgba(245,230,159,0.35)", 16, "rgba(236,230,163,0.25)"]}
    },
    "water": {
      "note": "2GIS Water / River polygons",
      "paint": {"fill-color": ["interpolate", ["linear"], ["zoom"], 10, "#A4D8EB", 12, "#9ED3F0", 15, "#92D1F0"]}
    },
    "waterway_river": {"note": "2GIS River, line", "paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 10, "#62AED8", 12, "#70BDE8", 15, "#92D1F0"]}},
    "waterway_other": {"paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 10, "#62AED8", 12, "#70BDE8", 15, "#92D1F0"]}},
    "waterway_tunnel": {"paint": {"line-color": "#92D1F0"}},
    "aeroway_fill": {"note": "2GIS Industrial area", "paint": {"fill-color": "#E9E8DD"}},
    "aeroway_runway": {"note": "2GIS Runway", "paint": {"line-color": "#FFFFFF"}},
    "aeroway_taxiway": {"paint": {"line-color": "#FFFFFF"}},

    "road_motorway_casing": {
      "note": "2GIS Federal outline",
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 10, "#F5A22E", 12, "#F29B21", 15, "#BF6F0D"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.7, 9, 2.8, 14, 5.5, 19, 25, 20, 27]
      }
    },
    "road_motorway": {
      "note": "2GIS Federal",
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 5, "#FAAC38", 10, "#F5A22E", 12, "#F29B21", 15, "#EE9211"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 9, 2, 14, 4, 19, 22, 20, 24]
      }
    },
    "road_motorway_link_casing": {"paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 10, "#F5A22E", 12, "#F29B21", 15, "#BF6F0D"]}},
    "road_motorway_link": {"paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 10, "#F5A22E", 12, "#F29B21", 15, "#EE9211"]}},
    "road_trunk_primary_casing": {
      "note": "2GIS Magistral background",
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 9, "#F5A22E", 12, "#ED9B35", 14.5, "#E19D48"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 9, 1.2, 14, 4, 16, 8, 20, 20]
      }
    },
    "road_trunk_primary": {
      "note": "2GIS Magistral",
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 5, "#F7AD48", 9.1, "#FFB046", 12, "#FBCC6F", 15, "#FFDFA0"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 9, 1, 14, 3, 16, 6.2, 20, 18.5]
      }
    },
    "road_link_casing": {"paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 9, "#F5A22E", 12, "#ED9B35", 14.5, "#E19D48"]}},
    "road_link": {"paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 9.1, "#FFB046", 12, "#FBCC6F", 15, "#FFDFA0"]}},
    "road_secondary_tertiary_casing": {
      "note": "secondary: 2GIS Magistral background (Astana's big prospects are secondary in OSM); tertiary: 2GIS Main background, a thin grey line below z13",
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 9, ["match", ["get", "class"], "secondary", "#F5A22E", "#A4A4A4"], 12, ["match", ["get", "class"], "secondary", "#ED9B35", "#A4A4A4"], 13, ["match", ["get", "class"], "secondary", "#E9A04A", "#B6B6B6"], 14.5, ["match", ["get", "class"], "secondary", "#E19D48", "#B6B6B6"]],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 8, ["match", ["get", "class"], "secondary", 0.6, 0.3], 11, ["match", ["get", "class"], "secondary", 1.6, 0.5], 13, ["match", ["get", "class"], "secondary", 3.6, 3.5], 19, ["match", ["get", "class"], "secondary", 17, 17], 20, ["match", ["get", "class"], "secondary", 18.5, 18]]
      }
    },
    "road_secondary_tertiary": {
      "note": "secondary: 2GIS Magistral; tertiary: 2GIS Main (white, from z13)",
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 9, ["match", ["get", "class"], "secondary", "#FFB046", "#FFFFFF"], 12, ["match", ["get", "class"], "secondary", "#FBCC6F", "#FFFFFF"], 15, ["match", ["get", "class"], "secondary", "#FFDFA0", "#FFFFFF"]],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 8, ["match", ["get", "class"], "secondary", 0.5, 0], 12.5, ["match", ["get", "class"], "secondary", 2, 0], 13, ["match", ["get", "class"], "secondary", 2.6, 2.5], 19, ["match", ["get", "class"], "secondary", 15.5, 15], 20, ["match", ["get", "class"], "secondary", 17, 16]]
      }
    },
    "road_minor_casing": {
      "note": "2GIS Other background",
      "paint": {
        "line-color": "#A4A4A4",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.2, 13, 0.4, 14, 2.6, 19, 17, 20, 18]
      }
    },
    "road_minor": {
      "note": "2GIS Other",
