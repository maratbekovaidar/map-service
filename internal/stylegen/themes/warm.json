  "insert": [
    {
      "note": "2GIS Industrial area (Garage_quarter, Technical_quarter); Liberty has no industrial fill",
      "before": "landcover_wood",
      "layer": {
        "id": "landuse_industrial",
        "type": "fill",
        "source": "openmaptiles",
        "source-layer": "landuse",
        "filter": ["match", ["get", "class"], ["industrial", "garages", "railway", "quarry"], true, false],
        "paint": {"fill-color": ["interpolate", ["linear"], ["zoom"], 9, "#EFEFE1", 12, "#E9E8DD", 16, "#E9E9E2"]}
      }
    },
    {
      "note": "2GIS Pedestrian street background",
      "before": "road_path_pedestrian",
      "layer": {
        "id": "road_pedestrian_casing",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "minzoom": 14,
        "filter": ["all", ["==", ["geometry-type"], "LineString"], ["!", ["match", ["get", "brunnel"], ["bridge", "tunnel"], true, false]], ["==", ["get", "class"], "pedestrian"]],
        "layout": {"line-cap": "round", "line-join": "round"},
        "paint": {"line-color": "#A8B5A0", "line-width": ["interpolate", ["exponential", 2], ["zoom"], 14, 1.5, 15, 5, 19, 16.5, 20, 16.5]}
      }
    },
    {
      "note": "2GIS Pedestrian street",
      "before": "road_path_pedestrian",
      "layer": {
        "id": "road_pedestrian",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "minzoom": 14,
        "filter": ["all", ["==", ["geometry-type"], "LineString"], ["!", ["match", ["get", "brunnel"], ["bridge", "tunnel"], true, false]], ["==", ["get", "class"], "pedestrian"]],
        "layout": {"line-cap": "round", "line-join": "round"},
        "paint": {"line-color": ["interpolate", ["linear"], ["zoom"], 14, "#EDF5DC", 16, "#F8FCEF"], "line-width": ["interpolate", ["exponential", 2], ["zoom"], 14, 1, 15, 4, 19, 14, 20, 14]}
      }
    },
    {
      "note": "2GIS House numbers: shown from z16, under every other label",
      "before": "water_name_line",
      "layer": {
        "id": "housenumber",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "housenumber",
        "minzoom": 16,
        "layout": {
          "text-field": ["to-string", ["get", "housenumber"]],
          "text-font": ["Noto Sans Regular"],
          "text-size": ["interpolate", ["linear"], ["zoom"], 16, 10, 20, 15],
          "text-padding": 2
        },
        "paint": {
          "text-color": ["interpolate", ["linear"], ["zoom"], 16, "#7B7770", 20, "#626256"],
          "text-halo-color": "rgba(255,255,255,0.7)",
          "text-halo-width": 0.9
        }
      }
    }
  ]
}
