      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 15.5, 0, 16, 2, 18, 7, 20, 10]
      }
    },
    "road_path_pedestrian": {
      "note": "2GIS park footpath: green dashes; pedestrian streets get their own layers (inserted below)",
      "filter": ["all", ["==", "$type", "LineString"], ["!in", "brunnel", "bridge", "tunnel"], ["==", "class", "path"]],
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 14, "rgba(94,156,77,0.6)", 18, "#5E9C4D"],
        "line-dasharray": [2, 1.5],
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 17, 1.2, 20, 2]
      }
    },
